# ── FileNova v2 backend config ─────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`.

# Port the VPS process listens on (behind Nginx/Caddy TLS terminator)
PORT=3100

# Comma-separated allowed origins for CORS + Socket.io.
# Production example: CORS_ORIGIN=https://filenova.in
CORS_ORIGIN=http://localhost:3100

# Required. Long random string used to hash room codes (pepper).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROOM_CODE_PEPPER=change-me-to-64-hex-chars-min

# Static-file + persistence paths (relative to backend/ is fine)
FRONTEND_DIR=../frontend
UPLOAD_DIR=./uploads
DATA_FILE=./data/rooms.json

# Upload caps (Step 3+)
CHUNK_PLAIN_BYTES=1048576
CHUNK_UPLOAD_MAX_BYTES=2097152
MAX_FILE_BYTES=2147483648
MAX_FILES_PER_ROOM=20
MAX_TEXTS_PER_ROOM=50
MAX_TEXT_CIPHERTEXT_CHARS=184320

# Trust reverse proxy (Nginx/Caddy) so rate-limit sees real IPs + secure cookies work
TRUST_PROXY=1
