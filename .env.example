NODE_ENV=development
PORT=4173
BASE_PATH=/

DATABASE_URL=postgres://filemaster:filemaster@localhost:5432/filemaster_ai
REDIS_URL=redis://localhost:6379

S3_REGION=ap-south-1
S3_BUCKET=filemaster-ai-uploads
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_ENDPOINT=

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_DROPBOX_APP_KEY=your_dropbox_app_key_here
VITE_GOOGLE_APP_ID=your_google_app_id_here
SESSION_SECRET=your_session_secret_here
CSRF_SECRET=your_csrf_secret_here

MAX_UPLOAD_MB=100
UPLOAD_TTL_MINUTES=60
ENABLE_VIRUS_SCAN=false
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_BACKGROUND_REMOVAL=true

# Razorpay Credentials (India)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# Frontend Razorpay key (public, safe to expose)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here


